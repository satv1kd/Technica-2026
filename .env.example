# --- Sonar app keys (copy to .env, never commit) ---
# OpenAI key: runs the tutor (Codex, Responses API) and the fallback voice
CODEX_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
CODEX_MODEL=gpt-5.3-codex
# minimal, low, medium, or high; low keeps spoken replies quick
CODEX_REASONING=low

# Tiger Data (Postgres + TimescaleDB) connection string
DATABASE_URL=
# Only if the URL above has no password in it (the Tiger console shows them separately)
DATABASE_PASSWORD=
# Integration tests (npm run test:db); may be the same database
TEST_DATABASE_URL=

# Alpaca market data (optional; CSV fallback is used if empty)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Solana devnet (optional; ledger-only settlement is used if unreachable)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_SECRET_KEY=

# Service URLs
ENGINE_URL=http://localhost:8000
CHAIN_URL=http://localhost:8001

# --- Task Master (optional: config uses the claude-code provider, no key needed) ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Trading engine account (optional; defaults to the "Demo learner" account)
ENGINE_ACCOUNT_ID=
