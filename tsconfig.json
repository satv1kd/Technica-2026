{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@services/*": ["./backend/services/*"],
      "@web/*": ["./frontend/web/*"]
    }
  },
  "include": ["backend/**/*.ts", "frontend/web/**/*.ts", "frontend/web/**/*.tsx", "frontend/tests/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
