{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@services/*": ["./services/*"],
      "@web/*": ["./apps/web/*"]
    }
  },
  "include": ["services/**/*.ts", "apps/web/**/*.ts", "apps/web/**/*.tsx", "tests/**/*.ts", "bridge/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
