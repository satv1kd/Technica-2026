{
  "name": "sonar",
  "private": true,
  "version": "0.1.0",
  "description": "Sonar: voice-first investing tutor for blind and low-vision learners",
  "workspaces": [
    "frontend/web"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend/web",
    "build": "npm run build -w frontend/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env backend/services/data/migrate.ts",
    "db:refresh": "tsx --env-file-if-exists=.env backend/services/data/migrate.ts --refresh",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run backend/tests/db.integration.test.ts",
    "test:e2e": "playwright test",
    "chain": "tsx --env-file-if-exists=.env backend/services/chain/server.ts",
    "chain:setup": "tsx --env-file-if-exists=.env backend/services/chain/setup.ts",
    "test:devnet": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run backend/tests/chain.devnet.test.ts",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run backend/tests/tutor/tutor.live.test.ts",
    "test:frontend": "vitest run frontend/tests/unit",
    "test:firmware": "c++ -std=c++17 -I backend/firmware/palm_arm backend/firmware/palm_arm/test/host_test.cpp -o node_modules/.palm_arm_test && node_modules/.palm_arm_test",
    "test:backend": "vitest run backend/tests"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
