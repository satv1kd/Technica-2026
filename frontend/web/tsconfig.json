{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../backend/bridge/**/*.ts",
    "../../backend/services/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-e2e/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
